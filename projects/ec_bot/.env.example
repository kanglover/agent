# 环境变量样例
#
# 使用方式：复制为 .env 后填真实值（本地开发），或在托管平台的环境变量面板逐项配置。
# 每项的默认值见 conf/app_config.yaml，不填即沿用本地 docker-compose 的地址。

# ---------- 大模型（必填） ----------
MODEL_NAME=
LLM_API_KEY=
LLM_API_BASE=

# ---------- 元数据库 MySQL ----------
# 本地为 docker-compose 里的 mysql 容器；云端填托管实例地址
META_DB_HOST=localhost
META_DB_PORT=3306
META_DB_USER=admin
META_DB_PASSWORD=123456
META_DB_NAME=meta
# 托管实例连接数紧张，云端建议调到 3 左右（meta 与 dw 各一份）
META_DB_POOL_SIZE=10
# 托管 MySQL 强制 TLS，云端置 true
META_DB_SSL=false

# ---------- 数仓 MySQL ----------
DW_DB_HOST=localhost
DW_DB_PORT=3306
DW_DB_USER=admin
DW_DB_PASSWORD=123456
DW_DB_NAME=dw
DW_DB_POOL_SIZE=10
DW_DB_SSL=false

# 连接空闲多久后回收重建，单位秒
DB_POOL_RECYCLE=1800
# 是否校验服务端证书；遇到证书链报错再临时关掉
DB_SSL_VERIFY=true

# ---------- Qdrant 向量库 ----------
# local：本地容器；cloud：Qdrant Cloud 托管集群（需要 api_key 且开 https）
QDRANT_PROVIDER=local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false
QDRANT_TIMEOUT=30
# 必须与所选 Embedding 模型的输出维度一致
EMBEDDING_SIZE=1024

# ---------- Embedding ----------
# local：本地 TEI 推理服务；openai：任意 OpenAI 兼容接口
EMBEDDING_PROVIDER=local
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_BATCH_SIZE=20

# ---------- 字段取值召回 ----------
# mysql：用 MySQL 的 ngram 全文索引，无需额外托管服务（推荐用于免费部署）
# es：用 Elasticsearch 全文索引，需要部署带 IK 分词插件的 ES
VALUE_STORE_PROVIDER=mysql
VALUE_STORE_TABLE=value_index
VALUE_SCORE_THRESHOLD=0.6
VALUE_QUERY_LIMIT=20

# ---------- Elasticsearch（仅 VALUE_STORE_PROVIDER=es 时需要） ----------
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_NAME=data_agent

# ---------- 跨域访问（前后端分离部署必填） ----------
# 前端部署在 Vercel、后端部署在 Render 时两者不同源，必须放行前端域名，
# 否则浏览器会拦截所有 /api 请求。多个域名用英文逗号分隔。
# 本地开发放行 http://localhost:5173 即可；线上填 Vercel 的正式域名。
CORS_ALLOW_ORIGINS=http://localhost:5173
# 可选：Vercel 每次推送都会生成新的预览域名，用正则一次覆盖
# 注意 YAML/环境变量里反斜杠需要转义，实际写入的值为 https://ec-bot-.*\.vercel\.app
CORS_ALLOW_ORIGIN_REGEX=
# 接口不依赖 Cookie 鉴权，保持 false
CORS_ALLOW_CREDENTIALS=false

# ---------- 日志 ----------
# 容器里建议关掉文件日志，直接看平台的标准输出
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=INFO
LOG_FILE_PATH=logs
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
